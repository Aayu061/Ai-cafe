# ==============================================================================
# AI CAFÉ BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SERVICE ACCOUNT CREDENTIALS OR PRIVATE KEYS TO GIT.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# For local development: http://localhost:3000
# For production: https://your-production-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# FIREBASE ADMIN SDK CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# Never use NEXT_PUBLIC_* variables for server-side Firebase Admin credentials.
#
# Provide credentials using OPTION 1 (Recommended for Render) OR OPTION 2:
#
# --- OPTION 1: Single Raw JSON String (Best for Render environment variables) ---
# Paste the entire content of your serviceAccountKey.json as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"ai-cafe-2deb5",...}'
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- OPTION 2: Discrete Fields ---
FIREBASE_PROJECT_ID=ai-cafe-2deb5
FIREBASE_CLIENT_EMAIL=
# Note: In .env files or Render dashboard, wrap the private key in quotes and preserve \n:
FIREBASE_PRIVATE_KEY=
