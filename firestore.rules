rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection (Customers): Users can read and update only their own document.
    // Self-promotion defense: Clients CANNOT alter role, status, or permissions.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        && (!('status' in request.resource.data) || request.resource.data.status == 'active')
        && (!('permissions' in request.resource.data) || request.resource.data.permissions.size() == 0);
      allow update: if isOwner(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'permissions']);
      allow delete: if false; // Account deletion handled via backend/Admin SDK
    }

    // Staff Accounts Collection: Read allowed by the account owner.
    // Writes are strictly controlled via authorized server APIs / Admin SDK.
    match /staffAccounts/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Admin Accounts Collection: Read allowed by the account owner.
    // Writes are strictly controlled via authorized server APIs / Admin SDK.
    match /adminAccounts/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Super Admin Accounts Collection: Read allowed by the account owner.
    // Writes are strictly controlled via authorized server APIs / Admin SDK.
    match /superAdminAccounts/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Products & Ingredients: Publicly readable by all, writable only by server/admin
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Only Admin SDK can modify catalog
    }

    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if false; // Only Admin SDK can modify ingredients
    }

    // Operational Collections (Inventory, Movements, Recipes, Audit Logs):
    // Direct client mutation is strictly forbidden; all state changes run through server-authoritative APIs.
    match /inventory/{inventoryId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /inventoryMovements/{movementId} {
      allow read: if false; // Read only via authorized admin API
      allow write: if false;
    }

    match /recipes/{recipeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if false; // Read only via authorized admin API
      allow write: if false;
    }

    // Carts: Only the owner can read/write their cart
    match /carts/{cartId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Orders: Users can view their own orders; state updates strictly managed via server
    match /orders/{orderId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; // Operational state updates managed via server
    }

    // Reviews: Publicly readable; only author can create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Favorites: Only the owner can access/manage their favorites
    match /favorites/{favoriteId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
